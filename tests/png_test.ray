// The PNG codec and the half-block renderer: encode→decode round-trip,
// every filter type against hand-computed pixels, palette images, and the
// sprite line contract.
import png;
import sprite;

@test
fn rgba_roundtrip_survives_encode_and_decode() {
    let pixels = [
        png.rgba(255, 0, 0, 255),
        png.rgba(0, 255, 0, 255),
        png.rgba(0, 0, 255, 255),
        png.rgba(10, 20, 30, 128),
        png.rgba(0, 0, 0, 0),
        png.rgba(200, 100, 50, 255)
    ];
    let img = png.Image { w: 3, h: 2, pixels: pixels };
    let data = png.encode_rgba(img);
    // A real PNG: signature + readable back.
    assert_eq(data.sub_bytes(0, 8), png.signature());
    match (png.decode(data)) {
        Result.Ok(back) => {
            assert_eq(back.w, 3);
            assert_eq(back.h, 2);
            var i = 0;
            while (i < 6) {
                assert_eq(back.pixels[i], pixels[i]);
                i = i + 1;
            }
        },
        Result.Err(e) => assert(false),
    }
}

@test
fn sub_and_up_filters_reconstruct_the_hand_computed_pixels() {
    // 2×2 RGB: row 0 uses filter 1 (sub), row 1 uses filter 2 (up).
    let raw = [1, 10, 20, 30, 5, 5, 5, 2, 3, 4, 10, 5, 5, 15];
    let data = png.signature() + png.ihdr(
        2,
        2,
        2
    ) + png.chunk("IDAT", png.zlib_store(bytes_of(raw))) + png.chunk("IEND", b"");
    match (png.decode(data)) {
        Result.Ok(img) => {
            assert_eq(img.pixels[0], png.rgba(10, 20, 30, 255));
            assert_eq(img.pixels[1], png.rgba(15, 25, 35, 255));
            assert_eq(img.pixels[2], png.rgba(13, 24, 40, 255));
            assert_eq(img.pixels[3], png.rgba(20, 30, 50, 255));
        },
        Result.Err(e) => assert(false),
    }
}

@test
fn average_and_paeth_filters_reconstruct_the_hand_computed_pixels() {
    // 2×2 RGB: row 0 uses filter 3 (average), row 1 uses filter 4 (paeth).
    let raw = [3, 10, 20, 30, 6, 11, 16, 4, 1, 2, 3, 5, 5, 5];
    let data = png.signature() + png.ihdr(
        2,
        2,
        2
    ) + png.chunk("IDAT", png.zlib_store(bytes_of(raw))) + png.chunk("IEND", b"");
    match (png.decode(data)) {
        Result.Ok(img) => {
            assert_eq(img.pixels[0], png.rgba(10, 20, 30, 255));
            assert_eq(img.pixels[1], png.rgba(11, 21, 31, 255));
            assert_eq(img.pixels[2], png.rgba(11, 22, 33, 255));
            assert_eq(img.pixels[3], png.rgba(16, 27, 38, 255));
        },
        Result.Err(e) => assert(false),
    }
}

@test
fn palette_images_resolve_through_plte() {
    let plte = bytes_of([255, 0, 0, 0, 255, 0]);
    let raw = [0, 0, 1];
    let data = png.signature() + png.ihdr(
        2,
        1,
        3
    ) + png.chunk("PLTE", plte) + png.chunk("IDAT", png.zlib_store(bytes_of(raw))) + png.chunk("IEND", b"");
    match (png.decode(data)) {
        Result.Ok(img) => {
            assert_eq(img.w, 2);
            assert_eq(img.pixels[0], png.rgba(255, 0, 0, 255));
            assert_eq(img.pixels[1], png.rgba(0, 255, 0, 255));
        },
        Result.Err(e) => assert(false),
    }
}

@test
fn bad_data_is_a_clean_error() {
    match (png.decode(b"not a png at all")) {
        Result.Ok(img) => assert(false),
        Result.Err(e) => assert(e.len() > 0),
    }
    // Palette index out of range must not panic.
    let plte = bytes_of([255, 0, 0]);
    let raw = [0, 7];
    let data = png.signature() + png.ihdr(
        1,
        1,
        3
    ) + png.chunk("PLTE", plte) + png.chunk("IDAT", png.zlib_store(bytes_of(raw))) + png.chunk("IEND", b"");
    match (png.decode(data)) {
        Result.Ok(img) => assert(false),
        Result.Err(e) => assert(e.len() > 0),
    }
}

@test
fn sprite_lines_pack_two_pixel_rows_per_cell() {
    // 2×2 fully opaque: one line, with both fg and bg truecolor codes.
    let full = png.Image {
        w: 2,
        h: 2,
        pixels: [
            png.rgba(255, 0, 0, 255),
            png.rgba(0, 255, 0, 255),
            png.rgba(0, 0, 255, 255),
            png.rgba(9, 9, 9, 255)
        ]
    };
    let lines = sprite.render(full);
    assert_eq(lines.len(), 1);
    assert(lines[0].contains("[38;2;255;0;0m"));
    assert(lines[0].contains("[48;2;0;0;255m"));
    assert(lines[0].contains("▀"));
    // Transparent bottom: fg-only upper half block, no background code.
    let top_only = png.Image { w: 1, h: 2, pixels: [png.rgba(1, 2, 3, 255), png.rgba(0, 0, 0, 0)] };
    let t = sprite.render(top_only);
    assert_eq(t.len(), 1);
    assert(t[0].contains("[38;2;1;2;3m"));
    assert(!t[0].contains("[48;2"));
    // Transparent top: lower half block.
    let bottom_only = png.Image {
        w: 1,
        h: 2,
        pixels: [png.rgba(0, 0, 0, 0), png.rgba(4, 5, 6, 255)]
    };
    assert(sprite.render(bottom_only)[0].contains("▄"));
    // Odd height still renders its last row.
    let odd = png.Image {
        w: 1,
        h: 3,
        pixels: [png.rgba(1, 1, 1, 255), png.rgba(2, 2, 2, 255), png.rgba(3, 3, 3, 255)]
    };
    assert_eq(sprite.render(odd).len(), 2);
}
