// rallyx — audible tour of the reactive score, end to end through the real
// pipe: tune → chase siren → flag jingle → crash sweep → game-over descent.
// Run: ray run tools/play_demo.ray (needs ffplay; ~6 s of sound)
import std/process;
import wsg;

fn main() -> int {
    let spawned = process
        .cmd("ffplay", [
        "-nodisp",
        "-autoexit",
        "-loglevel",
        "quiet",
        "-probesize",
        "32",
        "-analyzeduration",
        "0",
        "-f",
        "s16le",
        "-ar",
        "22050",
        "-ch_layout",
        "mono",
        "-i",
        "-"
    ])
        .stdin_pipe()
        .stream();
    let p = match (spawned) {
        Result.Ok(proc) => proc,
        Result.Err(e) => {
            eprint("play_demo: ffplay: " + e);
            return 1;
        },
    };
    let t = wsg.new_tracker();
    // (event, steps to play after it); 0 = no event.
    let script = [
        (0, 12),
        (wsg.EV_SMOKE, 5),
        (wsg.EV_DANGER_ON, 8),
        (wsg.EV_DANGER_OFF, 4),
        (wsg.EV_FLAG, 6),
        (wsg.EV_CRASH, 7),
        (wsg.EV_OVER, 14)
    ];
    var steps = 0;
    for (ev, n) in script.iter() {
        if (ev != 0) {
            wsg.apply(t, ev);
        }
        var i = 0;
        while (i < n) {
            match (p.write(wsg.tick(t))) {
                Result.Ok(w) => { },
                Result.Err(e) => {
                    eprint("play_demo: write: " + e);
                    return 1;
                },
            }
            steps = steps + 1;
            i = i + 1;
        }
    }
    p.close_stdin();
    match (p.wait()) {
        process.Exit.Code(code) => {
            print(
                "played " + to_string(steps) + " steps (" + to_string(steps * wsg.STEP_MS) + " ms), ffplay exit " + to_string(code)
            );
            code
        },
        process.Exit.Signal(sig) => {
            eprint("play_demo: ffplay killed by signal " + to_string(sig));
            1
        },
    }
}
