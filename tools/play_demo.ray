// rallyx — audible tour of the reactive score, straight to the device via
// std/audio: tune → smoke puff → chase siren → flag jingle → crash sweep →
// game-over descent. Run: ray run tools/play_demo.ray (~7 s of sound;
// RAY_AUDIO_SINK=null for a silent CI run)
import std/audio;
import wsg;

fn main() -> int {
    let h = match (audio.open(wsg.RATE, 1)) {
        Result.Ok(handle) => handle,
        Result.Err(e) => {
            eprint("play_demo: audio: " + e);
            return 1;
        },
    };
    let t = wsg.new_tracker();
    // (event, steps to play after it); 0 = no event.
    let script = [
        (0, 12),
        (wsg.EV_SMOKE, 5),
        (wsg.EV_DANGER_ON, 8),
        (wsg.EV_DANGER_OFF, 4),
        (wsg.EV_FLAG, 6),
        (wsg.EV_CRASH, 7),
        (wsg.EV_OVER, 14)
    ];
    var steps = 0;
    for (ev, n) in script.iter() {
        if (ev != 0) {
            wsg.apply(t, ev);
        }
        var i = 0;
        while (i < n) {
            match (audio.write(h, wsg.tick(t))) {
                Result.Ok(w) => { },
                Result.Err(e) => {
                    eprint("play_demo: write: " + e);
                    return 1;
                },
            }
            steps = steps + 1;
            i = i + 1;
        }
    }
    audio.drain(h);
    close(h);
    print(
        "played " + to_string(steps) + " steps (" + to_string(steps * wsg.STEP_MS) + " ms) via std/audio"
    );
    0
}
