import std/audio;
import std/time;

fn main() -> int {
    let h = match (audio.open(22050, 1)) {
        Result.Ok(x) => x,
        Result.Err(e) => {
            eprint(e);
            return 1;
        },
    };
    // 110 ms chunks of a quiet tone; watch when write starts parking.
    var chunk: [int] = [];
    var i = 0;
    while (i < 2425) {
        let v = if (i / 55 % 2 == 0) { 500 } else { 0 - 500 };
        chunk.push(v & 0xFF);
        chunk.push(v >> 8 & 0xFF);
        i = i + 1;
    }
    let data = bytes_of(chunk);
    let t0 = time.monotonic();
    var n = 0;
    while (n < 30) {
        let w0 = time.monotonic();
        audio.write(h, data);
        let took = time.monotonic() - w0;
        if (n % 3 == 0 || took > 20) {
            print(
                "chunk "
                    + to_string(n)
                    + ": write "
                    + to_string(took)
                    + " ms (audio total "
                    + to_string((n + 1) * 110)
                    + " ms, wall "
                    + to_string(time.monotonic() - t0)
                    + " ms)"
            );
        }
        n = n + 1;
    }
    close(h);
    0
}
