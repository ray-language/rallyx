// rallyx — the reactive music pump on std/audio (M145): a fiber synthesizes
// WSG steps and writes PCM straight to the device. Backpressure is the
// pacing: the output is opened with a small latency hint (LATENCY_MS), so
// audio.write parks once ~that much is queued — the device sets the TEMPO
// and game events reach the ear after ~the hint, not a 200 ms default queue
// (measured on raylang 1.27.50, macOS: a 30 ms hint queues ~40 ms). This
// replaces the wall-clock lead the pump kept while open_latency still queued
// ~120 ms for any small hint. Raise the hint only if you hear underruns.
// Game events arrive through a channel; drain+close end the fiber without
// clipping the tail.
import std/audio;
import wsg;

// Total queued between write and the speaker (std/audio accepts 20-1000).
const LATENCY_MS: int = 30;

pub struct Music {
    ch: Channel<int>,
    on: bool,
}

pub fn off() -> Music {
    let ch: Channel<int> = Channel.bounded(1);
    Music { ch: ch, on: false }
}

pub fn start() -> Music {
    let ch: Channel<int> = Channel.bounded(32);
    match (audio.open_latency(wsg.RATE, 1, LATENCY_MS)) {
        Result.Ok(h) => {
            spawn(fn() {
                pump(h, ch);
            });
            Music { ch: ch, on: true }
        },
        Result.Err(e) => {
            // No audio device: the game plays silent, nothing else changes.
            off()
        },
    }
}

pub fn send_event(m: Music, ev: int) {
    if (m.on) {
        send(m.ch, ev);
    }
}

pub fn stop(m: Music) {
    if (m.on) {
        send(m.ch, wsg.EV_STOP);
    }
}

fn pump(h: int, ch: Channel<int>) {
    let t = wsg.new_tracker();
    var running = true;
    while (running) {
        // Apply every queued event before synthesizing the next sub-step.
        while (running) {
            match (try_recv(ch)) {
                Received.Got(ev) => {
                    if (ev == wsg.EV_STOP) {
                        running = false;
                    } else {
                        wsg.apply(t, ev);
                    }
                },
                Received.Empty => {
                    break;
                },
                Received.Closed => {
                    running = false;
                },
            }
        }
        if (running) {
            // Parks while ~LATENCY_MS is queued: the device sets the tempo.
            match (audio.write(h, wsg.tick(t))) {
                Result.Ok(n) => {},
                Result.Err(dead) => {
                    // Device gone: fall silent, don't crash the game.
                    running = false;
                },
            }
        }
    }
    audio.drain(h);
    close(h);
}
