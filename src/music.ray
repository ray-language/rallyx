// rallyx — the reactive music pump on std/audio (M145): a fiber synthesizes
// WSG steps and writes PCM straight to the device. Pacing note: the device
// queue absorbs a couple hundred ms before audio.write parks the fiber, so
// pure backpressure sets the TEMPO but would delay events by the whole
// queue — the pump keeps a small wall-clock lead (LEAD_MS) instead. That
// lead only has to cover this loop's own jitter (a 20 ms nap, a slow tick),
// NOT any backend floor: since the raylang audio fix (backend byte_size =
// exactly what's taken, ~24 ms priming, ~8 ms keepalive, no silence padded
// into the 1x timeline), a slow start or an underrun heals itself in a
// frame or two instead of becoming permanent lag. So the lead is small on
// purpose — bump it only if you hear underruns, not to fight latency.
// Wall-clock pacing is now CORRECT here, no playback-clock scraping needed.
// Game events arrive through a channel; drain+close end the fiber without
// clipping the tail.
import std/audio;
import std/time;
import wsg;

// ~half a sub-step of slack over real time — enough to ride out one 20 ms
// nap or a slow tick, small enough that events reach the ear promptly. The
// backend no longer accumulates silence, so this no longer has to grow.
const LEAD_MS: int = 30;

pub struct Music {
    ch: Channel<int>,
    on: bool,
}

pub fn off() -> Music {
    let ch: Channel<int> = Channel.bounded(1);
    Music { ch: ch, on: false }
}

pub fn start() -> Music {
    let ch: Channel<int> = Channel.bounded(32);
    match (audio.open(wsg.RATE, 1)) {
        Result.Ok(h) => {
            spawn(fn() {
                pump(h, ch);
            });
            Music { ch: ch, on: true }
        },
        Result.Err(e) => {
            // No audio device: the game plays silent, nothing else changes.
            off()
        },
    }
}

pub fn send_event(m: Music, ev: int) {
    if (m.on) {
        send(m.ch, ev);
    }
}

pub fn stop(m: Music) {
    if (m.on) {
        send(m.ch, wsg.EV_STOP);
    }
}

fn pump(h: int, ch: Channel<int>) {
    let t = wsg.new_tracker();
    let t0 = time.monotonic();
    var written = 0;
    var running = true;
    while (running) {
        var draining = true;
        while (draining) {
            match (try_recv(ch)) {
                Received.Got(ev) => {
                    if (ev == wsg.EV_STOP) {
                        running = false;
                        draining = false;
                    } else {
                        wsg.apply(t, ev);
                    }
                },
                Received.Empty => {
                    draining = false;
                },
                Received.Closed => {
                    running = false;
                    draining = false;
                },
            }
        }
        if (running) {
            let ahead = written - (time.monotonic() - t0);
            if (ahead > LEAD_MS) {
                // Short naps keep the events fresh.
                time.sleep(20);
            } else {
                match (audio.write(h, wsg.tick(t))) {
                    Result.Ok(n) => {
                        written = written + wsg.SUB_MS;
                    },
                    Result.Err(dead) => {
                        // Device gone: fall silent, don't crash the game.
                        running = false;
                    },
                }
            }
        }
    }
    audio.drain(h);
    close(h);
}
