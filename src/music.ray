// rallyx — the reactive music pump on std/audio (M145): a fiber synthesizes
// WSG steps and writes PCM straight to the device. Pacing note, measured
// (tools/audio_buf.ray): the device queue absorbs ~1.7 s before audio.write
// parks the fiber, so pure backpressure sets the TEMPO but would delay
// events by the whole queue — the pump keeps a small wall-clock lead
// (LEAD_MS) instead, exactly like the ffplay era. What std/audio fixes for
// good is the failure mode: the device plays newly written audio
// immediately after any gap (no silence inserted into a stream timeline),
// so a slow start or an underrun heals itself instead of becoming
// permanent lag — wall-clock pacing is now CORRECT, no playback-clock
// scraping needed. Game events arrive through a channel; drain+close end
// the fiber without clipping the tail.
import std/audio;
import std/time;
import wsg;

const LEAD_MS: int = 100;

pub struct Music {
    ch: Channel<int>,
    on: bool,
}

pub fn off() -> Music {
    let ch: Channel<int> = Channel.bounded(1);
    Music { ch: ch, on: false }
}

pub fn start() -> Music {
    let ch: Channel<int> = Channel.bounded(32);
    match (audio.open(wsg.RATE, 1)) {
        Result.Ok(h) => {
            spawn(fn() {
                pump(h, ch);
            });
            Music { ch: ch, on: true }
        },
        Result.Err(e) => {
            // No audio device: the game plays silent, nothing else changes.
            off()
        },
    }
}

pub fn send_event(m: Music, ev: int) {
    if (m.on) {
        send(m.ch, ev);
    }
}

pub fn stop(m: Music) {
    if (m.on) {
        send(m.ch, wsg.EV_STOP);
    }
}

fn pump(h: int, ch: Channel<int>) {
    let t = wsg.new_tracker();
    let t0 = time.monotonic();
    var written = 0;
    var running = true;
    while (running) {
        var draining = true;
        while (draining) {
            match (try_recv(ch)) {
                Received.Got(ev) => {
                    if (ev == wsg.EV_STOP) {
                        running = false;
                        draining = false;
                    } else {
                        wsg.apply(t, ev);
                    }
                },
                Received.Empty => {
                    draining = false;
                },
                Received.Closed => {
                    running = false;
                    draining = false;
                },
            }
        }
        if (running) {
            let ahead = written - (time.monotonic() - t0);
            if (ahead > LEAD_MS) {
                // Short naps keep the events fresh.
                time.sleep(20);
            } else {
                match (audio.write(h, wsg.tick(t))) {
                    Result.Ok(n) => {
                        written = written + wsg.STEP_MS;
                    },
                    Result.Err(dead) => {
                        // Device gone: fall silent, don't crash the game.
                        running = false;
                    },
                }
            }
        }
    }
    audio.drain(h);
    close(h);
}
