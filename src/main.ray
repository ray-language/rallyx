// rallyx — Rally-X in the terminal: grab the flags, smoke the chasers.
import std/random;
import app;

fn main() -> int {
    let av = args();
    for a in av {
        if (a == "--seed") {
            random.seed(42);
        }
        if (a == "--help" || a == "-h") {
            eprint("usage: rallyx [--seed]");
            eprint("  ↑↓←→ conducir · espacio humo · p pausa · r reiniciar · q salir");
            return 0;
        }
    }
    app.play()
}
