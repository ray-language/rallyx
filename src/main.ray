// rallyx — Rally-X in the terminal: grab the flags, smoke the chasers.
import std/fs;
import std/image;
import std/random;
import std/term;
import app;
import sprite;

fn show_img(path: string) -> int {
    let data = match (fs.read_file_bytes(path)) {
        Result.Ok(d) => d,
        Result.Err(e) => {
            eprint("rallyx: " + path + ": " + e);
            return 1;
        },
    };
    let img = match (image.decode_png(data)) {
        Result.Ok(im) => im,
        Result.Err(e) => {
            eprint("rallyx: " + path + ": " + e);
            return 1;
        },
    };
    // Capability ladder, only when talking to a real terminal (the DA1
    // query needs raw mode): kitty gets the PNG itself, everyone else the
    // half-block rendering.
    // capabilities() runs its own raw stint for the DA1 query — never call
    // it inside another raw session.
    var kitty = false;
    if (term.is_tty(0) && term.is_tty(1)) {
        kitty = sprite.use_kitty(term.capabilities().kitty_graphics);
    }
    if (kitty) {
        // Pin a small display box (kitty c=/r=) so the art stays compact
        // instead of the terminal blowing it up. w/3 × h/6 keeps the aspect
        // right (cells are ~twice as tall as wide). Image bytes untouched.
        var rows = img.height / 6;
        if (rows < 1) {
            rows = 1;
        }
        print(sprite.kitty_png_box(data, img.width / 3, rows));
    } else {
        for line in sprite.render(img) {
            print(line);
        }
    }
    0
}

fn main() -> int {
    let av = args();
    var with_music = true;
    var i = 0;
    while (i < av.len()) {
        let a = av[i];
        if (a == "--no-music") {
            with_music = false;
        }
        if (a == "--img") {
            if (i + 1 >= av.len()) {
                eprint("rallyx: --img needs a PNG file");
                return 2;
            }
            return show_img(av[i + 1]);
        }
        if (a == "--seed") {
            random.seed(42);
        }
        if (a == "--help" || a == "-h") {
            eprint("usage: rallyx [--seed] [--no-music] [--img file.png]");
            eprint("  ↑↓←→ conducir · espacio humo · p pausa · r reiniciar · q salir");
            eprint(
                "  --img: dibuja un PNG (kitty graphics si el terminal puede; half-blocks si no)"
            );
            eprint("  --no-music: sin música (o si no hay ffplay, calla solo)");
            return 0;
        }
        i = i + 1;
    }
    app.play(with_music)
}
