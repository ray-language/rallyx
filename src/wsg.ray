// rallyx — a Namco-WSG-style synth, pure and clock-free: wavetable voices
// (32-entry, 4-bit) plus an LFSR noise voice, read through phase
// accumulators and mixed to s16le mono. On top, the tracker: a 32-step
// looping tune (melody/bass/arpeggio, an homage to the arcade's gallop —
// the original score is Namco's, this one is ours) with reactive states:
// chase siren, flag jingle, crash sweep, game-over descent, a smoke "pshh"
// that STEALS the arpeggio voice like the real WSG stole voices for SFX,
// and a constant engine drone underneath. The music fiber owns the clock;
// everything here is deterministic, so the score is testable byte by byte.

pub const RATE: int = 22050;

pub const STEP_MS: int = 110;

pub const SAMPLES_PER_STEP: int = 2425;

// A tick renders HALF a musical step: events picked up between ticks land
// on the ear a sub-step (55 ms) sooner.
pub const SUB_MS: int = 55;

pub const TONE: int = 0;

pub const BUZZ: int = 1;

pub const NOISE: int = 2;

// Soft flute-ish table (sine-like), values 0..15 like the arcade's PROM.
fn tone_table() -> [int] {
    [
        8,
        9,
        11,
        12,
        13,
        14,
        15,
        15,
        15,
        15,
        14,
        13,
        12,
        11,
        9,
        8,
        7,
        5,
        4,
        3,
        2,
        1,
        0,
        0,
        0,
        0,
        1,
        2,
        3,
        4,
        5,
        7
    ]
}

// Hollow square with a notch — the "engine" flavor.
fn buzz_table() -> [int] {
    [
        15,
        15,
        15,
        15,
        15,
        15,
        15,
        15,
        13,
        13,
        11,
        11,
        9,
        9,
        8,
        8,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        2,
        2,
        4,
        4,
        6,
        6,
        7,
        7
    ]
}

// Integer Hz for a MIDI note (C4=60 … A4=69=440). Good enough for chip music.
pub fn freq_of(midi: int) -> int {
    let base = [262, 277, 294, 311, 330, 349, 370, 392, 415, 440, 466, 494];
    let f = base[midi % 12];
    let oct = midi / 12 - 5;
    if (oct >= 0) { f << oct } else { f >> 0 - oct }
}

