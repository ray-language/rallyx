        4,
        3,
        2,
        1,
        0,
        0,
        0,
        0,
        1,
        2,
        3,
        4,
        5,
        7
    ]
}

// Hollow square with a notch — the "engine" voice.
fn buzz_table() -> [int] {
    [
        15,
        15,
        15,
        15,
        15,
        15,
        15,
        15,
        13,
