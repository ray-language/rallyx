// ---- reactive events -------------------------------------------------------

pub const EV_STOP: int = 0;

pub const EV_DANGER_ON: int = 1;

pub const EV_DANGER_OFF: int = 2;

pub const EV_FLAG: int = 3;

pub const EV_CRASH: int = 4;

pub const EV_OVER: int = 5;

pub const EV_RESET: int = 6;

pub struct Tracker {
    step: int,
    danger: bool,
    jingle: int,
    crash: int,
    over: bool,
    over_steps: int,
    phases: [int],
}

pub fn new_tracker() -> Tracker {
    Tracker {
        step: 0,
        danger: false,
        jingle: 0,
        crash: 0,
        over: false,
        over_steps: 0,
        phases: [0, 0, 0]
    }
}

pub fn apply(t: Tracker, ev: int) {
    if (ev == EV_DANGER_ON) {
        t.danger = true;
    } else if (ev == EV_DANGER_OFF) {
        t.danger = false;
    } else if (ev == EV_FLAG) {
        t.jingle = 4;
    } else if (ev == EV_CRASH) {
        t.crash = 6;
        t.jingle = 0;
    } else if (ev == EV_OVER) {
        t.over = true;
        t.over_steps = 12;
        t.crash = 0;
        t.jingle = 0;
    } else if (ev == EV_RESET) {
        t.over = false;
        t.over_steps = 0;
        t.crash = 0;
        t.jingle = 0;
        t.danger = false;
        t.step = 0;
    }
}

// The three (wave, midi, vol) voices for the current step, by priority:
// game-over descent > crash sweep > (siren | tune) + flag jingle on voice 2.
fn current_voices(t: Tracker) -> [(int, int, int)] {
    if (t.over) {
        if (t.over_steps <= 0) {
            return [(TONE, 0, 0), (TONE, 0, 0), (TONE, 0, 0)];
        }
        // A slow chromatic farewell.
        let n = 72 - (12 - t.over_steps);
        return [(TONE, n, 12), (BUZZ, n - 24, 9), (TONE, 0, 0)];
    }
    if (t.crash > 0) {
        let n = 70 - (6 - t.crash) * 3;
        return [(BUZZ, n, 13), (BUZZ, n - 12, 10), (TONE, 0, 0)];
    }
    var v0 = (TONE, melody()[t.step % 32], 10);
    var v1 = (BUZZ, bass()[t.step % 32], 9);
    var v2 = (TONE, arp()[t.step % 32], 5);
    if (t.danger) {
        // The chase siren: two alternating tones over a tritone pulse.
        let hi = if (t.step / 2 % 2 == 0) { 81 } else { 76 };
        v0 = (BUZZ, hi, 11);
        v1 = (BUZZ, if (t.step % 4 < 2) { 48 } else { 54 }, 10);
        v2 = (TONE, 0, 0);
    }
    if (t.jingle > 0) {
        let ladder = [84, 88, 91, 96];
        v2 = (TONE, ladder[4 - t.jingle], 14);
    }
    return [v0, v1, v2];
}

// Render one step of audio and advance the tracker. s16le mono bytes.
pub fn tick(t: Tracker) -> bytes {
    let voices = current_voices(t);
    let tables = [tone_table(), buzz_table()];
    var incs: [int] = [];
    var vols: [int] = [];
    var waves: [int] = [];
    for (wave, midi, vol) in voices.iter() {
        let f = if (midi > 0) { freq_of(midi) } else { 0 };
        incs.push(f * 2097152 / RATE);
        vols.push(if (midi > 0) { vol } else { 0 });
        waves.push(wave);
    }
    var out: [int] = [];
    var i = 0;
    while (i < SAMPLES_PER_STEP) {
        var acc = 0;
        var v = 0;
        while (v < 3) {
            if (vols[v] > 0) {
                let idx = t.phases[v] >> 16 & 31;
                acc = acc + (tables[waves[v]][idx] - 8) * vols[v];
                t.phases[v] = t.phases[v] + incs[v];
            }
            v = v + 1;
        }
        let sample = acc * 90;
        out.push(sample & 0xFF);
        out.push(sample >> 8 & 0xFF);
        i = i + 1;
    }
    t.step = (t.step + 1) % 32;
    if (t.jingle > 0) {
        t.jingle = t.jingle - 1;
    }
    if (t.crash > 0) {
        t.crash = t.crash - 1;
    }
    if (t.over_steps > 0) {
        t.over_steps = t.over_steps - 1;
    }
    bytes_of(out)
}
