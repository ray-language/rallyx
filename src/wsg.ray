// ---- reactive events -------------------------------------------------------

pub const EV_STOP: int = 0;

pub const EV_DANGER_ON: int = 1;

pub const EV_DANGER_OFF: int = 2;

pub const EV_FLAG: int = 3;

pub const EV_CRASH: int = 4;

pub const EV_OVER: int = 5;

pub const EV_RESET: int = 6;

pub const EV_SMOKE: int = 7;

pub const EV_ENGINE_RUN: int = 8;

pub const EV_ENGINE_IDLE: int = 9;

pub const EV_ENGINE_LIMP: int = 10;

pub const ENGINE_RUN: int = 0;

pub const ENGINE_IDLE: int = 1;

pub const ENGINE_LIMP: int = 2;

pub struct Tracker {
    step: int,
    danger: bool,
    jingle: int,
    crash: int,
    puff: int,
    over: bool,
    over_steps: int,
    engine: int,
    sub: int,
    phases: [int],
    lfsr: int,
}

pub fn new_tracker() -> Tracker {
    Tracker {
        step: 0,
        danger: false,
        jingle: 0,
        crash: 0,
        puff: 0,
        over: false,
        over_steps: 0,
        engine: ENGINE_RUN,
        sub: 0,
        phases: [0, 0, 0, 0],
        lfsr: 0x4A1F
    }
}

pub fn apply(t: Tracker, ev: int) {
    if (ev == EV_DANGER_ON) {
        t.danger = true;
    } else if (ev == EV_DANGER_OFF) {
        t.danger = false;
    } else if (ev == EV_FLAG) {
        t.jingle = 4;
    } else if (ev == EV_SMOKE) {
        t.puff = 3;
    } else if (ev == EV_ENGINE_RUN) {
        t.engine = ENGINE_RUN;
    } else if (ev == EV_ENGINE_IDLE) {
        t.engine = ENGINE_IDLE;
    } else if (ev == EV_ENGINE_LIMP) {
        t.engine = ENGINE_LIMP;
    } else if (ev == EV_CRASH) {
        t.crash = 6;
        t.jingle = 0;
        t.puff = 0;
    } else if (ev == EV_OVER) {
        t.over = true;
        t.over_steps = 12;
        t.crash = 0;
        t.jingle = 0;
        t.puff = 0;
    } else if (ev == EV_RESET) {
        t.over = false;
        t.over_steps = 0;
        t.crash = 0;
        t.jingle = 0;
        t.puff = 0;
        t.danger = false;
        t.engine = ENGINE_RUN;
        t.step = 0;
        t.sub = 0;
    }
}

// The four (wave, midi, vol) voices for the current step, by priority:
// game-over descent > crash sweep > (siren | tune); the smoke puff steals
// voice 2 (over the jingle), and voice 3 is the engine drone — silent only
// when the car itself is out of the picture (crash, game over).
fn current_voices(t: Tracker) -> [(int, int, int)] {
    if (t.over) {
        if (t.over_steps <= 0) {
            return [(TONE, 0, 0), (TONE, 0, 0), (TONE, 0, 0), (TONE, 0, 0)];
        }
        // A slow chromatic farewell.
        let n = 72 - (12 - t.over_steps);
        return [(TONE, n, 12), (BUZZ, n - 24, 9), (TONE, 0, 0), (TONE, 0, 0)];
    }
    if (t.crash > 0) {
        let n = 70 - (6 - t.crash) * 3;
        return [(BUZZ, n, 13), (BUZZ, n - 12, 10), (TONE, 0, 0), (TONE, 0, 0)];
    }
    var v0 = (TONE, melody()[t.step % 32], 10);
    var v1 = (BUZZ, bass()[t.step % 32], 8);
    var v2 = (TONE, arp()[t.step % 32], 5);
    if (t.danger) {
        // The chase siren: two alternating tones over a tritone pulse.
        let hi = if (t.step / 2 % 2 == 0) { 81 } else { 76 };
        v0 = (BUZZ, hi, 11);
        v1 = (BUZZ, if (t.step % 4 < 2) { 48 } else { 54 }, 10);
        v2 = (TONE, 0, 0);
    }
    if (t.jingle > 0) {
        let ladder = [84, 88, 91, 96];
        v2 = (TONE, ladder[4 - t.jingle], 14);
    }
    if (t.puff > 0) {
        // The smoke hiss decays over three steps and outranks the jingle —
        // exactly the voice-stealing the arcade did.
        let fade = [12, 8, 5];
        v2 = (NOISE, 60, fade[3 - t.puff]);
    }
    // Engine drone under the music, following the real car: running hums
    // with a two-step wobble, idling against a wall drops low and steady,
    // an empty tank sputters (every other step the cylinder misses).
    var v3 = (BUZZ, if (t.step % 2 == 0) { 33 } else { 34 }, 4);
    if (t.engine == ENGINE_IDLE) {
        v3 = (BUZZ, 30, 3);
    } else if (t.engine == ENGINE_LIMP) {
        v3 = (BUZZ, if (t.step % 2 == 0) { 31 } else { 29 }, if (t.step % 2 == 0) { 5 } else { 0 });
    }
    return [v0, v1, v2, v3];
}

// Render one SUB-step (55 ms) of audio and advance the tracker; the
// musical position moves every second tick. Voices are recomputed each
// call, so an applied event is audible at the next sub-step boundary.
// s16le mono bytes.
pub fn tick(t: Tracker) -> bytes {
    let voices = current_voices(t);
    let tables = [tone_table(), buzz_table()];
    var incs: [int] = [];
    var vols: [int] = [];
    var waves: [int] = [];
    for (wave, midi, vol) in voices.iter() {
        let f = if (midi > 0) { freq_of(midi) } else { 0 };
        incs.push(f * 2097152 / RATE);
        vols.push(if (midi > 0) { vol } else { 0 });
        waves.push(wave);
    }
    let n = if (t.sub == 0) { 1213 } else { SAMPLES_PER_STEP - 1213 };
    var out: [int] = [];
    var i = 0;
    while (i < n) {
        var acc = 0;
        var v = 0;
        while (v < 4) {
            if (vols[v] > 0) {
                if (waves[v] == NOISE) {
                    // 15-bit LFSR hiss, advanced every other sample so the
                    // puff sounds like air rather than static.
                    if ((i & 1) == 0) {
                        let bit = (t.lfsr ^ t.lfsr >> 1) & 1;
                        t.lfsr = t.lfsr >> 1 | bit << 14;
                    }
                    acc = acc + ((t.lfsr & 1) * 14 - 7) * vols[v];
                } else {
                    let idx = t.phases[v] >> 16 & 31;
                    acc = acc + (tables[waves[v]][idx] - 8) * vols[v];
                    t.phases[v] = t.phases[v] + incs[v];
                }
            }
            v = v + 1;
        }
        let sample = acc * 72;
        out.push(sample & 0xFF);
        out.push(sample >> 8 & 0xFF);
        i = i + 1;
    }
    t.sub = 1 - t.sub;
    if (t.sub == 0) {
        t.step = (t.step + 1) % 32;
        if (t.jingle > 0) {
            t.jingle = t.jingle - 1;
        }
        if (t.puff > 0) {
            t.puff = t.puff - 1;
        }
        if (t.crash > 0) {
            t.crash = t.crash - 1;
        }
        if (t.over_steps > 0) {
            t.over_steps = t.over_steps - 1;
        }
    }
    bytes_of(out)
}
