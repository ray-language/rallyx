// rallyx — a Namco-WSG-style synth, pure and clock-free: 3 voices reading
// 32-entry 4-bit wavetables through a phase accumulator, mixed to s16le
// mono. On top, the tracker: a 32-step looping tune (melody/bass/arpeggio)
// with reactive states — chase siren, flag jingle, crash sweep, game-over
// descent. The music fiber owns the clock; everything here is deterministic,
// so the whole score is testable byte by byte.

pub const RATE: int = 22050;

pub const STEP_MS: int = 110;

pub const SAMPLES_PER_STEP: int = 2425;

pub const TONE: int = 0;

pub const BUZZ: int = 1;

