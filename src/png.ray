// rallyx — a minimal pure-raylang PNG ENCODER: RGBA8 with filter 0 and
// STORED deflate blocks (no compressor needed), correct CRC-32 and
// Adler-32. Decoding is std/image's job since M144 and the game's asset is
// written by std/image's encode_png since M164 (tools/gen_assets.ray); this
// module stays as the INDEPENDENT fixture builder (any color type, raw
// filter bytes, palettes, hand-made chunks) for the differential tests
// that pin std/image against hand-computed pixels.

// A pixel is (a << 24) | (r << 16) | (g << 8) | b.
pub fn rgba(r: int, g: int, b: int, a: int) -> int {
    a << 24 | r << 16 | g << 8 | b
}

pub struct Image {
    w: int,
    h: int,
    pixels: [int],
}

pub fn signature() -> bytes {
    b"\x89PNG\r\n\x1a\n"
}

fn be32(n: int) -> [int] {
    [n >> 24 & 0xFF, n >> 16 & 0xFF, n >> 8 & 0xFF, n & 0xFF]
}

fn crc32(data: bytes) -> int {
    var crc = 0xFFFFFFFF;
    var i = 0;
    while (i < data.len()) {
        crc = crc ^ data[i];
        var k = 0;
        while (k < 8) {
            let lsb = crc & 1;
            crc = crc >> 1;
            if (lsb == 1) {
                crc = crc ^ 0xEDB88320;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    crc ^ 0xFFFFFFFF
}

fn adler32(data: bytes) -> int {
    var a = 1;
    var b = 0;
    var i = 0;
    while (i < data.len()) {
        a = (a + data[i]) % 65521;
        b = (b + a) % 65521;
        i = i + 1;
    }
    return b << 16 | a;
}

pub fn chunk(tag: string, body: bytes) -> bytes {
    let payload = tag.to_bytes() + body;
    bytes_of(be32(body.len())) + payload + bytes_of(be32(crc32(payload)))
}

// Wrap raw data in a zlib stream of STORED deflate blocks (no compression).
pub fn zlib_store(raw: bytes) -> bytes {
    var out: [int] = [0x78, 0x1];
    var off = 0;
    var done = false;
    while (!done) {
        var n = raw.len() - off;
        if (n > 65535) {
            n = 65535;
        }
        let last = off + n >= raw.len();
        out.push(if (last) { 1 } else { 0 });
        out.push(n & 0xFF);
        out.push(n >> 8 & 0xFF);
        out.push((n ^ 0xFFFF) & 0xFF);
        out.push((n ^ 0xFFFF) >> 8 & 0xFF);
        var i = 0;
        while (i < n) {
            out.push(raw[off + i]);
            i = i + 1;
        }
        off = off + n;
        done = last;
    }
    bytes_of(out) + bytes_of(be32(adler32(raw)))
}

pub fn ihdr(w: int, h: int, color_type: int) -> bytes {
    var body = be32(w);
    for v in be32(h) {
        body.push(v);
    }
    body.push(8);
    body.push(color_type);
    body.push(0);
    body.push(0);
    body.push(0);
    chunk("IHDR", bytes_of(body))
}

// RGBA, filter 0 on every row, stored blocks: a valid PNG any tool opens
// (CRCs are real — std/image verifies them on the way back in).
pub fn encode_rgba(img: Image) -> bytes {
    var raw: [int] = [];
    var y = 0;
    while (y < img.h) {
        raw.push(0);
        var x = 0;
        while (x < img.w) {
            let p = img.pixels[y * img.w + x];
            raw.push(p >> 16 & 0xFF);
            raw.push(p >> 8 & 0xFF);
            raw.push(p & 0xFF);
            raw.push(p >> 24 & 0xFF);
            x = x + 1;
        }
        y = y + 1;
    }
    signature()
        + ihdr(img.w, img.h, 6)
        + chunk("IDAT", zlib_store(bytes_of(raw)))
        + chunk("IEND", b"")
}
