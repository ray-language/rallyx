// rallyx — drawing decoded images (std/image RGBA8) in the terminal, best
// capability first: real pixels over the kitty graphics protocol when
// term.capabilities() says so, truecolor half-blocks (▀ fg = top pixel,
// bg = bottom pixel — chafa/viu's technique) everywhere else. Alpha < 128
// is transparent.
import std/base64;
import std/image;

fn esc() -> string {
    "\u{1B}"
}

fn env_has(name: string) -> bool {
    match (env(name)) {
        Option.Some(v) => v.len() > 0,
        Option.None => false,
    }
}

fn term_contains(needle: string) -> bool {
    match (env("TERM")) {
        Option.Some(v) => v.contains(needle),
        Option.None => false,
    }
}

// Whether to drive the kitty graphics protocol. `detected` is what
// term.capabilities() decided (a TERM/KITTY_WINDOW_ID heuristic that misses
// Ghostty and other kitty-capable terminals), so we widen it: Ghostty
// (TERM=xterm-ghostty, GHOSTTY_* in the environment) and anything kitty-ish
// count too. RALLYX_KITTY=1/0 forces the decision when a terminal lies.
pub fn use_kitty(detected: bool) -> bool {
    match (env("RALLYX_KITTY")) {
        Option.Some(v) => {
            return v == "1" || v == "true";
        },
        Option.None => { },
    }
    if (detected) {
        return true;
    }
    return env_has("KITTY_WINDOW_ID") || env_has("GHOSTTY_RESOURCES_DIR") || env_has(
        "GHOSTTY_BIN_DIR"
    ) || term_contains("kitty") || term_contains("ghostty");
}

fn channel(img: image.Image, x: int, y: int, c: int) -> int {
    img.pixels[(y * img.width + x) * 4 + c]
}

fn fg(img: image.Image, x: int, y: int) -> string {
    esc() + "[38;2;" + to_string(
        channel(img, x, y, 0)
    ) + ";" + to_string(channel(img, x, y, 1)) + ";" + to_string(channel(img, x, y, 2)) + "m"
}

fn bg(img: image.Image, x: int, y: int) -> string {
    esc() + "[48;2;" + to_string(
        channel(img, x, y, 0)
    ) + ";" + to_string(channel(img, x, y, 1)) + ";" + to_string(channel(img, x, y, 2)) + "m"
}

fn opaque(img: image.Image, x: int, y: int) -> bool {
    channel(img, x, y, 3) >= 128
}

// One text line per two pixel rows. Every line ends with a reset so the
// sprite composes into any frame.
pub fn render(img: image.Image) -> [string] {
    var out: [string] = [];
    var y = 0;
    while (y < img.height) {
        var line = "";
        var x = 0;
        while (x < img.width) {
            let top_on = opaque(img, x, y);
            let bottom_on = y + 1 < img.height && opaque(img, x, y + 1);
            if (top_on && bottom_on) {
                line = line + fg(img, x, y) + bg(img, x, y + 1) + "▀";
            } else if (top_on) {
                line = line + esc() + "[0m" + fg(img, x, y) + "▀";
            } else if (bottom_on) {
                line = line + esc() + "[0m" + fg(img, x, y + 1) + "▄";
            } else {
                line = line + esc() + "[0m ";
            }
            x = x + 1;
        }
        out.push(line + esc() + "[0m");
        y = y + 2;
    }
    out
}

// The kitty graphics protocol: the PNG file itself, base64ed into APC
// escapes, chunked at 4096 payload bytes (m=1 … m=0). The terminal decodes
// the PNG — we just deliver it at the cursor.
pub fn kitty_png(data: bytes) -> string {
    chunked(data, "a=T,f=100")
}

// Same delivery, but pin the on-screen size to a cols×rows cell box (kitty
// c=/r=). Without this the terminal picks the size and tends to blow small
// pixel art up huge; a small box keeps it compact so the pixels don't read
// as chunky. The image bytes are untouched — this is display size only.
pub fn kitty_png_box(data: bytes, cols: int, rows: int) -> string {
    chunked(data, "a=T,f=100,c=" + to_string(cols) + ",r=" + to_string(rows))
}

fn chunked(data: bytes, head: string) -> string {
    let b64 = base64.base64(data);
    var out = "";
    var off = 0;
    var first = true;
    while (off < b64.len() || first) {
        var end = off + 4096;
        if (end > b64.len()) {
            end = b64.len();
        }
        let more = if (end < b64.len()) { "1" } else { "0" };
        let ctl = if (first) { head + ",m=" + more } else { "m=" + more };
        out = out + esc() + "_G" + ctl + ";" + b64.substring(off, end) + esc() + "\\";
        first = false;
        off = end;
    }
    out
}
